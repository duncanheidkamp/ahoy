# Copy to mobile/.env (gitignored) and fill in from Supabase dashboard ->
# Project Settings -> API. Both values are public (shipped in the app bundle).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: set after `eas init` if you'd rather not have it written into
# app config. `eas init` normally prints the id to add here.
# EAS_PROJECT_ID=

# Optional: path to the Firebase google-services.json for Android push in
# local builds (EAS cloud builds use a file env var of the same name). See
# README "Push notifications". Or place the file at mobile/google-services.json.
# GOOGLE_SERVICES_JSON=/absolute/path/to/google-services.json

# Invite-links domain (the links/ static site). One value used for invite URLs,
# iOS associated domains and the Android App Links filter — changing it needs a
# new native build. Placeholder until the domain is chosen.
# EXPO_PUBLIC_LINKS_DOMAIN=ahoy.example

# Google Sign-In OAuth client IDs (Google Cloud console, see README "Social
# login"). Public values. The Google button stays hidden until the web id and
# the platform's id are set.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234-web.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234-ios.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=1234-android.apps.googleusercontent.com
